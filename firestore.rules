rules_version = '2';

// Reglas de seguridad de Firestore para Hands4Events.
// Modelo: cada worker accede SOLO a lo suyo; el admin gestiona todo.
// El despliegue lo hace el desarrollador con: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function estaLogueado() {
      return request.auth != null;
    }

    // Lee el doc del usuario actual y comprueba que su rol sea 'admin'.
    function esAdmin() {
      return estaLogueado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    // ¿El uid indicado es el del usuario logueado?
    function esMio(uid) {
      return estaLogueado() && request.auth.uid == uid;
    }

    // ¿El usuario está asignado al evento (o es admin)?
    function esMiembroEvento(eventoId) {
      return esAdmin()
        || (estaLogueado()
            && request.auth.uid in get(/databases/$(database)/documents/eventos/$(eventoId)).data.trabajadoresIds);
    }

    // ¿El evento existe y está publicado? Null-safe: si no existe, false; si no tiene
    // campo `estado` (evento antiguo), la comparación da false y también deniega.
    function eventoPublicado(eventoId) {
      return exists(/databases/$(database)/documents/eventos/$(eventoId))
        && get(/databases/$(database)/documents/eventos/$(eventoId)).data.estado == 'publicado';
    }

    // ---------- users ----------
    // Cada worker lee y edita SOLO su propio perfil. El admin gestiona todos.
    match /users/{userId} {
      allow read: if esMio(userId) || esAdmin();
      allow create: if esAdmin();            // las altas de trabajadores las hace el admin
      allow update: if esMio(userId) || esAdmin();
      allow delete: if esAdmin();
    }

    // ---------- eventos ----------
    // Lee: el admin, el worker asignado (confirmado), o cualquier worker logueado si el
    // evento está 'publicado' (necesario para el feed tipo Tinder). Los eventos antiguos
    // sin 'estado' NO son legibles por workers no asignados, y eso es correcto.
    // Solo el admin crea/edita/borra: el worker NO se añade a sí mismo a trabajadoresIds.
    match /eventos/{eventoId} {
      allow read: if esAdmin()
        || (estaLogueado() && request.auth.uid in resource.data.trabajadoresIds)
        || (estaLogueado() && resource.data.estado == 'publicado');
      allow create, update, delete: if esAdmin();
    }

    // ---------- eventos/{id}/equipo (fichas del equipo, CON teléfono) ----------
    // El teléfono vive aquí y NO en trabajadoresInfo: el doc del evento lo lee cualquier
    // worker si está 'publicado' (feed), pero esta subcolección solo la leen los MIEMBROS
    // del evento (uid en trabajadoresIds del padre) o el admin. Escribe solo el admin.
    match /eventos/{eventoId}/equipo/{uid} {
      allow read: if esMiembroEvento(eventoId);
      allow write: if esAdmin();
    }

    // ---------- postulaciones (respuestas del worker al feed) ----------
    // El worker lee, crea y borra SOLO las suyas. Al crear, el estado solo puede ser
    // 'pendiente' o 'rechazado_por_worker' — nunca 'confirmado' (eso es del admin) — y
    // el evento debe estar 'publicado' (no se puede postular a un borrador ni a uno
    // finalizado, aunque se forje la petición fuera de la app).
    // La actualización (confirmar/descartar) es exclusiva del admin.
    match /postulaciones/{postulacionId} {
      allow read: if esAdmin() || esMio(resource.data.trabajadorId);
      allow create: if esAdmin()
        || (esMio(request.resource.data.trabajadorId)
            && (request.resource.data.estado == 'pendiente'
                || request.resource.data.estado == 'rechazado_por_worker')
            && eventoPublicado(request.resource.data.eventoId));
      allow delete: if esAdmin() || esMio(resource.data.trabajadorId);
      allow update: if esAdmin();
    }

    // ---------- fichajes ----------
    // El worker ficha SOLO por sí mismo. El admin consulta todos.
    match /fichajes/{fichajeId} {
      allow read: if esMio(resource.data.trabajadorId) || esAdmin();
      allow create: if esMio(request.resource.data.trabajadorId) || esAdmin();
      allow update, delete: if esMio(resource.data.trabajadorId) || esAdmin();
    }

    // ---------- mensajes (chat por evento) ----------
    // Leen/escriben el admin y los workers asignados al evento del mensaje.
    match /mensajes/{mensajeId} {
      allow read: if esMiembroEvento(resource.data.eventoId);
      // Al crear, el remitente debe ser uno mismo y hay que pertenecer al evento.
      allow create: if esMiembroEvento(request.resource.data.eventoId)
        && request.resource.data.remitenteId == request.auth.uid;
      // Solo el autor (o el admin) edita/borra su mensaje.
      allow update, delete: if esAdmin() || esMio(resource.data.remitenteId);
    }

    // ---------- nominas ----------
    // El worker lee SOLO sus nóminas. Solo el admin las crea/edita/borra.
    match /nominas/{nominaId} {
      allow read: if esMio(resource.data.trabajadorId) || esAdmin();
      allow create, update, delete: if esAdmin();
    }

    // ---------- notificaciones ----------
    // El worker lee, marca como leída y borra SOLO las suyas. Las crea el admin (al
    // confirmar una postulación); la Cloud Function onNotificacionCreada corre con
    // privilegios de admin y no pasa por estas reglas.
    match /notificaciones/{notificacionId} {
      allow read: if esAdmin() || esMio(resource.data.trabajadorId);
      allow create: if esAdmin();
      // En su propia notificación, el worker solo puede tocar el campo `leida`.
      allow update: if esAdmin()
        || (esMio(resource.data.trabajadorId)
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['leida']));
      allow delete: if esAdmin() || esMio(resource.data.trabajadorId);
    }

    // ---------- Por defecto: denegado ----------
    // Todo lo que no encaje arriba queda bloqueado explícitamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
